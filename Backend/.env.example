PORT=5000
# MongoDB connection URI (Optional: Server automatically falls back to in-memory mode if missing)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apnakissan?retryWrites=true&w=majority

# Gemini API Key (Optional: Server automatically falls back to offline Multi-Agent simulation mode if missing)
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox Token for Geographic maps
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
